-- 2023 Week 11 -- 
with cte1 as (
    select customer,
       branch,
       address_long / (180 / pi()) as address_long,
       address_lat / (180 / pi()) as address_lat,
       branch_long / (180 / pi()) as branch_long,
       branch_lat / (180 / pi()) as branch_lat,
       address_long  as address_long_original,
       address_lat as address_lat_original,
       branch_long  as branch_long_original,
       branch_lat  as branch_lat_original,
    from pd2023_wk11_dsb_customer_locations
    join pd2023_wk11_dsb_branches
),

cte2 as (select *, 
                round(3963 * acos((sin(address_lat) * sin(branch_lat)) + cos(address_lat) * cos(branch_lat) * cos(branch_long - address_long)), 2) as distance 
        from cte1)

select branch,
       branch_long_original,
       branch_lat_original,
       distance,
       rank() over (partition by branch order by distance asc) as customer_priority,
       customer,
       address_long_original,
       address_lat_original
from cte2;
