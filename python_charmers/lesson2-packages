        "# Import the `requires` function from the `importlib.metadata` package\n",
        "\n",
        "import importlib.metadata\n",
        "\n",
        "# Create two variables that contain lists of dependencies for pandas and numpy\n",
        "\n",
        "pandas_requirements = importlib.metadata.requires('pandas')\n",
        "\n",
        "numpy_requirements = importlib.metadata.requires('numpy') or []\n",
        "\n",
        "# Combine the dependencies lists\n",
        "\n",
        "full_requirements = pandas_requirements + numpy_requirements\n",
        "\n",
        "# Convert to a set to remove duplicates and then back to a list\n",
        "\n",
        "final_requirements = []\n",
        "\n",
        "for i in full_requirements:\n",
        "  if not i in final_requirements:\n",
        "    final_requirements.append(i)\n",
        "\n",
        "print(final_requirements)\n",
        "\n",
        "# # Print combined list of unique dependencies\n"
